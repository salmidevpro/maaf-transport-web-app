MAAF_DB_HOST=127.0.0.1
MAAF_DB_PORT=3306
MAAF_DB_USER=maaf_app
MAAF_DB_PASSWORD=replace-with-your-database-password
MAAF_DB_NAME=maaf_transport
MAAF_DB_CONNECTION_LIMIT=10

# Keep this secret stable. NIN values are matched through an HMAC fingerprint, not stored in plaintext.
MAAF_NIN_HASH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
MAAF_NIN_ENCRYPTION_KEY=replace-with-base64-encoded-random-32-byte-key

# Resend email configuration for agent verification and portal password resets (use your verified sending domain).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=MAAF Accounts <accounts@yourdomain.com>
# Runtime URL used when generating email links (set this in cPanel).
MAAF_SITE_URL=https://maafnigerialtd.com
# Legacy alias is still supported; MAAF_SITE_URL takes precedence.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional initial accounts used by `npm run db:setup` when those roles are empty.
MAAF_BOOTSTRAP_ADMIN_EMAIL=
MAAF_BOOTSTRAP_ADMIN_PASSWORD=
MAAF_BOOTSTRAP_ADMIN_NAME=MAAF Administrator
MAAF_BOOTSTRAP_AGENT_EMAIL=
MAAF_BOOTSTRAP_AGENT_PASSWORD=
MAAF_BOOTSTRAP_AGENT_NAME=MAAF Agent
